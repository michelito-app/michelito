# Caddy in front of the demo (see docs/deployment.md). Automatic HTTPS for {$MICHELITO_HOST}.
{
	# HTTP/1.1 and HTTP/2 only: the firewall opens 443/tcp, not UDP (HTTP/3).
	servers {
		protocols h1 h2
	}
	# The container is read-only and has nobody to install a local CA for.
	skip_install_trust
}

{$MICHELITO_HOST} {
	encode zstd gzip

	header {
		# defer: applied last, after what reverse_proxy adds (so Via is removed).
		defer
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# The interface is a Vite build: its own scripts, styles and fonts, the API on the same
		# origin; nothing inline or third-party.
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		X-Frame-Options "DENY"
		-Server
		-Via
	}

	reverse_proxy app:8600 {
		# X-Forwarded-For: Caddy replaces it with the IP of whoever connected (a single hop) and
		# drops the one the client sends, because there are no `trusted_proxies`. The app takes
		# the last one.
		header_up -X-Real-IP
		header_up -Forwarded
	}
}
